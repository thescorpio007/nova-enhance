<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.deepseek.chat" />
        <package android:name="ai.x.grok" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="Nova Enhance"
        android:supportsRtl="true"
        android:theme="@style/NovaTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick sheet: Share menu, the text-selection menu, the bubble and the tile all open this. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:label="Nova Enhance"
            android:excludeFromRecents="true"
            android:taskAffinity="com.nova.enhance.capture"
            android:theme="@style/NovaSheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="✦ Enhance" android:priority="999">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".CompareActivity" android:exported="false" />
        <activity android:name=".LangActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="com.nova.enhance.lang" android:theme="@style/NovaSheet" android:windowSoftInputMode="stateVisible" />
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 🖥 My PC: Nova's data from your PC (pairing QR opens here: novaenhance://pair?d=…) -->
        <activity android:name=".MyPcActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="novaenhance" android:host="pair" />
            </intent-filter>
        </activity>
        <provider android:name=".PcFiles" android:authorities="com.nova.enhance.pcfiles" android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".PcSyncJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- ✍ Nova as the phone's spell checker: red = spelling, blue = grammar (your AI); your words never marked -->
        <service android:name=".NovaSpell" android:exported="true" android:label="Nova Enhance"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data android:name="android.view.textservice.scs" android:resource="@xml/spellchecker" />
        </service>


        <service
            android:name=".NovaKeyboard"
            android:exported="true"
            android:label="Nova Enhance"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating bubble that lets the user send copied text to the app for enhancement" />
        </service>

        <service
            android:name=".EnhanceTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Enhance copied text"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
            <!-- Updates from GitHub Releases (signature + SHA-256 + same key checked before installing) -->
        <activity android:name="com.nova.enhance.UpdateActivity" android:exported="false" />
        <receiver android:name="com.nova.enhance.UpdateReceiver" android:exported="false" />
        <service android:name="com.nova.enhance.UpdateJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
