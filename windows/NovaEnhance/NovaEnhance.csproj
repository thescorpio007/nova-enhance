<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NovaEnhance</AssemblyName>
    <RootNamespace>NovaEnhance</RootNamespace>
    <ApplicationIcon>nova.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <Product>Nova Enhance for Windows</Product>
    <Company>A.HAMROUNI</Company>
    <Copyright>Designed by A.HAMROUNI</Copyright>
    <Description>Nova Enhance for Windows</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);CA1416;CS8632;WFO1000;WFAC010;CS0162;CS0168;CS0219</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="MimeKit" Version="4.8.0" />
    <PackageReference Include="MsgReader" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="TestData\**" />
  </ItemGroup>

</Project>
