#include <winver.h>

#include "novaver.h"
#ifndef NOVA_VER
#define NOVA_VER 2,0,0,0
#define NOVA_VER_S "2.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NOVA_VER
 PRODUCTVERSION NOVA_VER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "A.HAMROUNI"
            VALUE "FileDescription", "Nova Enhance - Nova tab for Microsoft Office"
            VALUE "FileVersion", NOVA_VER_S
            VALUE "InternalName", "NovaRibbon"
            VALUE "LegalCopyright", "Designed by A.HAMROUNI"
            VALUE "OriginalFilename", "NovaRibbon.dll"
            VALUE "ProductName", "Nova Enhance for Windows"
            VALUE "ProductVersion", NOVA_VER_S
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
